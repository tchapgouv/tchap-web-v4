.tc_badge {

    span {
        font-size: smaller;
        margin-right: 2px;
        text-transform: uppercase;
        border-radius: 4px;
        font-weight: 700;

        &.description {
            display: none;
        }

        /* Show text only on larger screens */
        @media (min-width: 750px) {
            &.description {
                display: inline;
            }
        }
    }

    .external {
        background-color: var(--badge-external-color);
    }


}
