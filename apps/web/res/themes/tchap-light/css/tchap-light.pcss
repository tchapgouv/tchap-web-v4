@layer compound-tokens, compound-web, shared-components, app-web;

/* @import "@gouvfr-lasuite/integration/dist/css/homepage-full.css"; */
@import "_tchap_custom_vars.pcss" layer(app-web);
@import "../../../../res/css/_font-sizes.pcss" layer(app-web); /* font sizes from matrix-react-sdk */
@import "../../tchap-common/css/_paths.pcss" layer(app-web); /* tchap custom path to load ressources inside matrix css */
@import "../../../../res/themes/light/css/_fonts.pcss" layer(app-web); /* tchap custom fonts */
@import "../../../../res/themes/light/css/_light.pcss" layer(app-web); /* base _light css */
@import "../../../../res/themes/light-custom/css/_custom.pcss" layer(app-web); /* match css --vars to pcss $vars */
@import "../../../../res/themes/light/css/_mods.pcss" layer(app-web);
@import "../../../../res/css/_components.pcss" layer(app-web); /* css of all components */
@import "../../tchap-common/css/_tchap_custom.pcss" layer(app-web); /* import override from the common folder */
/* @import "../../tchap-common/css/_fonts.pcss"; tchap custom fonts */
@import "_tchap_custom.pcss" layer(app-web);
@import url("highlight.js/styles/atom-one-light.css") layer(app-web); /* taken from matrix theme, don't know what it is */
@import url("github-markdown-css/github-markdown-light.css") layer(app-web);
