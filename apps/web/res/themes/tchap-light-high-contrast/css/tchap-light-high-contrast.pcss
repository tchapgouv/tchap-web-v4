@layer compound-tokens, compound-web, shared-components, app-web;

/* activate _custom.pcss after settings _tchap_custom_vars */
@import "_tchap_custom_vars.pcss" layer(app-web);
@import "../../../../res/css/_font-sizes.pcss" layer(app-web);
@import "../../tchap-common/css/_paths.pcss" layer(app-web);
@import "../../../../res/themes/light/css/_fonts.pcss" layer(app-web);
@import "../../../../res/themes/light/css/_light.pcss" layer(app-web);/* base _light css, used the base variable from the light theme */
@import "../../../../res/themes/light-high-contrast/css/_light-high-contrast.pcss" layer(app-web);/* base _light hc css */
@import "../../../../res/themes/light/css/_mods.pcss" layer(app-web);
@import "../../../../res/css/_components.pcss" layer(app-web);
@import "../../tchap-common/css/_tchap_custom.pcss" layer(app-web); /* import override from the common folder */
@import "_tchap_custom.pcss" layer(app-web);
/* @import "../../tchap-common/css/_fonts.pcss"; tchap custom fonts */
@import url("highlight.js/styles/atom-one-light.css") layer(app-web);
@import url("github-markdown-css/github-markdown-light.css") layer(app-web);