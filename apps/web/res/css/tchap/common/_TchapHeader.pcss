.fr-enlarge-link a {
  background-image: none;
  outline-width: 0;
}

.fr-enlarge-link a::before {
	bottom: 0;
	content: "";
	display: block;
	height: 100%;
	left: 0;
	outline-color: inherit;
	outline-offset: 2px;
	outline-style: inherit;
	outline-width: 2px;
	position: absolute;
	right: 0;
	top: 0;
	width: 100%;
	z-index: 1;
}

.lasuite-header__service-link {
	display: flex;
	align-items: center;
	text-decoration: none;
}